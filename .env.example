# Geoportal polling
AZS_POLL_SECONDS=300
AZS_CACHE_TTL_SECONDS=60
AZS_REQUEST_TIMEOUT=20
AZS_DB_PATH=data/azs.sqlite3

# Authentication is generated by ./setup_auth.sh
# AZS_AUTH_PASSWORD_HASH=scrypt:...
# AZS_TELEGRAM_BOT_TOKEN=...
# AZS_TELEGRAM_ALLOWED_USER_ID=691131427
# AZS_SESSION_SECRET=...
AZS_SESSION_HOURS=12

# Keep 0 while the site is served over plain HTTP.
# Set to 1 only after HTTPS is configured.
AZS_COOKIE_SECURE=0
